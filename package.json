{
  "name": "obsidian-sample-plugin",
  "version": "1.0.0",
  "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:mcp": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production mcp",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "check": "npm run typecheck && npm run check:example && npm run lint",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "node scripts/clean.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "gen:example": "node --experimental-strip-types scripts/gen-example-node.mjs",
    "check:example": "node --experimental-strip-types scripts/gen-example-node.mjs --check",
    "test:cdp": "node --test tests/cdp-camera.test.mjs",
    "test:diff": "node --experimental-strip-types --test tests/diffraction.test.mjs",
    "sweep:grounding": "node scripts/sweep-grounding.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "gifenc": "^1.0.3"
  }
}
